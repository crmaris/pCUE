  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- Auto-increment the AssemblyFileVersion on every Release compile, in +0.1 steps:
       1.3.1 -> 1.3.2 -> 1.3.3 ...  (three components; the LAST one is the revision).
       Only the file version is bumped; AssemblyVersion is intentionally left stable.
       Debug builds do NOT bump, to avoid churning AssemblyInfo.cs during development.
       The regex deliberately requires the closing quote right after the third component, so a
       stray four-part version is NOT matched - it is reported instead of being silently mangled. -->
  <UsingTask TaskName="BumpFileVersionRevision" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyInfoPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string text = File.ReadAllText(AssemblyInfoPath);
        string updated = Regex.Replace(
            text,
            "AssemblyFileVersion\\(\"(\\d+)\\.(\\d+)\\.(\\d+)\"\\)",
            delegate(Match m) {
                int major = int.Parse(m.Groups[1].Value);
                int minor = int.Parse(m.Groups[2].Value);
                int rev   = int.Parse(m.Groups[3].Value) + 1;
                // The last component is a TENTH, so it carries: 1.3.9 -> 1.4.0, not 1.3.10.
                // Without this the "+0.1" scheme breaks down into two-digit revisions.
                if (rev > 9) { rev = 0; minor++; }
                if (minor > 9) { minor = 0; major++; }
                return "AssemblyFileVersion(\"" + major + "." + minor + "." + rev + "\")";
            });
        if (updated != text) {
            File.WriteAllText(AssemblyInfoPath, updated);
            Log.LogMessage(MessageImportance.High, "pCUE: bumped AssemblyFileVersion (+0.1).");
        } else {
            Log.LogMessage(MessageImportance.High, "pCUE: no three-part AssemblyFileVersion found - version NOT bumped.");
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="BumpRevisionBeforeCompile" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <BumpFileVersionRevision AssemblyInfoPath="$(MSBuildProjectDirectory)\Properties\AssemblyInfo.cs" />
  </Target>
