<?xml version="1.0" encoding="utf-8"?>
<!-- targetFramework mix is historical (net461/net472) but harmless: the app targets net48 and
     each package's nearest compatible lib is picked via HintPath. Do not "normalize" without
     re-validating the HidSharp 2.1.0 / LHM 0.9.4 pins in AGENTS.md. -->
<packages>
  <package id="Dirkster.NumericUpDownLib" version="2.4.2.2" targetFramework="net461" />
  <package id="HidSharp" version="2.1.0" targetFramework="net461" />
  <package id="LibreHardwareMonitorLib" version="0.9.4" targetFramework="net472" />
</packages>